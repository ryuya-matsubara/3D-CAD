{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "katachi-cad-sync",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "PROJECTS", "class_name": "Project" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Project"] }],
  "vars": { "APP_ORIGIN": "https://ryuya-matsubara.github.io" }
}
